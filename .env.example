# ===== AtivoFix - variaveis de ambiente =====
# Copie para templates/.env no servidor e preencha (o arquivo NAO vai pro git).

# --- Seguranca (OBRIGATORIO em producao) ---
FLASK_ENV=production
PANEL_USER=admin
PANEL_PASS=TROCAR_POR_SENHA_FORTE
FLASK_SECRET_KEY=TROCAR_POR_CHAVE_ALEATORIA_LONGA
PANEL_TENANT_ID=2

# --- Servidor ---
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Agente ---
AGENT_TOKEN=TROCAR_POR_TOKEN_LONGO_E_UNICO

# --- Email (SMTP) - recuperacao de senha e notificacoes ---
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=no-reply@seudominio.com
SMTP_PASS=TROCAR_SENHA_SMTP
SMTP_FROM=no-reply@seudominio.com

# --- Rate limit global (opcional) ---
# RATE_LIMIT=200 per hour
